[Unit]
Description=netwatch network monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/netwatch --config test_cluster/node-01/config.yaml
Restart=on-failure
RestartSec=5s
# CAP_NET_RAW is required for ICMP ping probes.
# Remove these two lines if you do not use type: ping targets.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
