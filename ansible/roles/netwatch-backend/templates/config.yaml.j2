# {{ ansible_managed }}
# Generated by Ansible for host: {{ inventory_hostname }}
# Do NOT edit directly — changes will be overwritten on next playbook run.

node_alias: "{{ inventory_hostname }}"
port: "{{ netwatch_http_port }}"
state_file: "{{ netwatch_state_dir }}/netwatch.db"
log_path: "{{ netwatch_log_path }}"

timeout: {{ netwatch_timeout }}
max_retries: {{ netwatch_max_retries }}
retry_interval_sec: 30
probe_interval_sec: {{ netwatch_probe_interval_sec }}
reload_interval_sec: 60

admin:
  setup_token: "{{ netwatch_setup_token }}"

cluster:
  enabled: true
  node_name: "{{ inventory_hostname }}"
  bind_port: {{ netwatch_gossip_port }}
  probe_replication_factor: {{ netwatch_probe_replication_factor }}
  # Peers are auto-built from the [netwatch_nodes] inventory group.
  # Re-run the playbook whenever you add or remove nodes.
  peers:
{% set ns = namespace(has_peers=false) %}
{% for host in groups['netwatch_nodes'] %}
{% if host != inventory_hostname %}
{% set ns.has_peers = true %}
    - {{ hostvars[host]['ansible_host'] | default(host) }}:{{ netwatch_gossip_port }}
{% endif %}
{% endfor %}
{% if not ns.has_peers %}
    []
{% endif %}

# ── Monitoring targets ────────────────────────────────────────────────────────
# Add the services you want this cluster to monitor.
# Each target is probed by every node; failing targets are cross-checked by
# probe_replication_factor additional nodes before raising an alert.
#
# Example HTTP target:
# targets:
#   - id: my-api
#     name: "My API"
#     type: http
#     target: "https://my-api.example.com/health"
#     options:
#       expected_status:
#         in: [200]
#
# Example ICMP ping target (requires CAP_NET_RAW, already configured):
# targets:
#   - id: gateway
#     name: "Default Gateway"
#     type: icmp
#     target: "192.168.1.1"
targets: []

# ── Notification channels ─────────────────────────────────────────────────────
# Example webhook:
# notifications:
#   pagerduty-webhook:
#     type: webhook
#     parameters:
#       url: "https://events.pagerduty.com/v2/enqueue"
notifications: {}

